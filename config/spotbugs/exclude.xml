    </Match>
    <Match>
        <Class name="com.fams.attachment.AttachmentUploadKeys"/>
        <Field name="db"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
