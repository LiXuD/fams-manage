    <Match>
        <Class name="~com\.fams\.assetimport\.(AssetImportBatchService|AssetImportPublicationService|AssetImportReviewService|AssetImportRollbackService|AssetInitializationWindowService)"/>
        <Field name="~(db|json)"/>
