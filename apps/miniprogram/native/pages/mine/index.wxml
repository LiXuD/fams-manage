<view class="page">
  <view class="title">我的账号</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view class="card">
    <view class="label">企业账号</view>
    <view class="value">{{accountId}}</view>
    <view class="hint">已绑定当前微信。账号权限及登录有效期由企业实时管理。</view>
  </view>
  <view class="card">
    <navigator url="/pages/request-center/index" open-type="redirect">申请中心</navigator>
    <navigator url="/pages/requests/index" open-type="redirect">我的申请与进度</navigator>
    <navigator url="/pages/loans/index" open-type="redirect">我的借用、延期与归还</navigator>
    <navigator url="/pages/department-requests/index" open-type="redirect">部门资产与代办（按当前权限）</navigator>
  </view>
  <view class="card">
    <button bindtap="onLogout" disabled="{{busy}}">退出登录</button>
    <button class="danger" bindtap="onUnbind" disabled="{{busy}}">解除微信绑定</button>
    <view class="hint">退出登录会清除本设备身份资料。解除绑定后，再次使用需重新短信验证；换设备可从登录页完成换绑。</view>
  </view>
</view>

<navigator url="/pages/receipts/index">待接收与实物核对</navigator>

<navigator url="/pages/transfer-receipts/index">调拨实物接收</navigator>

<navigator url="/pages/transfer-reassignment/index">调拨受控转派（资产管理员）</navigator>

<navigator url="/pages/proxy-confirmations/index">异常代确认（库管 / 资产管理员）</navigator>
<navigator url="/pages/business-result-notices/index">业务结果通知与责任核查</navigator>
<navigator url="/pages/business-result-reviews/index">代确认结果核查（资产管理员）</navigator>

<navigator url="/pages/target-changes/index">批准目标更正（库管 / 资产管理员）</navigator>

<navigator url="/pages/inventory-tasks/index">我的盘点任务与应盘资产</navigator>
