<view class="page">
  <view class="title">消息中心</view>
  <view class="hint">未读 {{unread}} 条。阅读不代表已办理，也不改变业务责任与时限。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{notice}}" class="hint">{{notice}}</view>
  <button bindtap="onRefresh" disabled="{{busy}}">刷新消息</button>
  <button wx:if="{{retryable}}" bindtap="onRetry" disabled="{{busy}}">原请求重试</button>
  <view wx:for="{{rows}}" wx:key="id" class="card">
    <view class="value">{{item.label}} · {{item.read ? '已读' : '未读'}}</view>
    <view>{{item.poolType}}<text wx:if="{{item.assigneeAccountId}}"> · 处理账号 {{item.assigneeAccountId}}</text></view>
    <view>{{item.businessDisplay}} {{item.businessId}} · 登记 {{item.openedDisplay}}</view>
    <view wx:if="{{item.deadlineDisplay}}">截止 {{item.deadlineDisplay}}</view>
    <button wx:if="{{!item.read}}" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="onRead" disabled="{{busy || retryable}}">标记已读</button>
    <button wx:if="{{item.link}}" data-id="{{item.id}}" bindtap="onOpen" disabled="{{busy || retryable}}">查看业务单据</button>
  </view>
  <view wx:if="{{!rows.length}}" class="hint">暂无站内消息。</view>
  <button wx:if="{{page > 1}}" bindtap="onPrevious" disabled="{{busy || retryable}}">上一页</button>
  <button wx:if="{{page * 20 &lt; total}}" bindtap="onNext" disabled="{{busy || retryable}}">下一页</button>
  <navigator url="/pages/mine/index" open-type="redirect">返回我的账号</navigator>
</view>
