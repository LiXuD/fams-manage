<wxs module="labels">
var names={PENDING_ADMIN_DECISION:'待管理员确认',WAITING_WAREHOUSE_CLAIM:'待库管领取',VERIFYING:'核实中',SEARCHING:'查找中',REJECTED:'已驳回',CANCELLED:'已撤回'};
module.exports={status:function(value){return names[value]||value;}};
</wxs>
<view class="page">
 <view class="title">报失与查找</view><view class="subtitle">提交只锁定资产；批准后核实查找，原责任与借用保留。</view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="hint">{{notice}}</view>
 <button bindtap="onRefresh" disabled="{{busy || confirmation}}">刷新并只读核对</button><view wx:if="{{retry}}" class="hint">原操作待确认：{{pendingLabel}}</view><button wx:if="{{retry}}" bindtap="onRetry" disabled="{{busy}}">使用原操作重试</button>
 <view wx:if="{{confirmation}}" class="card"><view>{{confirmation}}</view><button bindtap="onConfirm" disabled="{{busy}}">确认办理</button><button bindtap="onCancel" disabled="{{busy}}">返回修改</button></view>
 <view class="card"><view class="title">发起报失</view>
  <view wx:for="{{assets}}" wx:key="id"><view>{{item.assetCode}} · {{item.name}}</view><button bindtap="onAsset" data-id="{{item.id}}" disabled="{{busy || retry || confirmation || stale}}">{{selectedAsset === item.id ? '已选择' : '选择此资产'}}</button></view>
  <button bindtap="onPage" data-kind="assets" data-delta="-1" disabled="{{busy || retry || confirmation || assetPage <= 1}}">上一页资产</button><button bindtap="onPage" data-kind="assets" data-delta="1" disabled="{{busy || retry || confirmation || assetPage * 20 >= assetTotal}}">下一页资产</button>
  <view>最后见到日期与当地时间</view><picker mode="date" value="{{lastDate}}" data-field="lastDate" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{lastDate || '选择日期'}}</view></picker><picker mode="time" value="{{lastTime}}" data-field="lastTime" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{lastTime || '选择时间'}}</view></picker><button data-kind="last" bindtap="onNow" disabled="{{busy || retry || confirmation || stale}}">确认为当前实际时刻</button>
  <view>最后位置</view><input value="{{lastLocation}}" data-field="lastLocation" bindinput="onField" maxlength="500" disabled="{{busy || retry || confirmation || stale}}" />
  <view>找不到的实际情况（至少10字）</view><textarea value="{{circumstances}}" data-field="circumstances" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}" />
  <button data-action="submit" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">提交报失</button>
 </view>
 <view class="title">报失记录（{{total}}）</view><view wx:for="{{rows}}" wx:key="id" class="card"><view>{{item.source.assetCode}} · {{item.source.name}}</view><view>{{labels.status(item.status)}}</view><button data-id="{{item.id}}" bindtap="onOpen" disabled="{{busy || retry || confirmation || stale}}">查看报失单 {{item.id}}</button></view>
 <button data-kind="reports" data-delta="-1" bindtap="onPage" disabled="{{busy || retry || confirmation || page <= 1}}">上一页记录</button><button data-kind="reports" data-delta="1" bindtap="onPage" disabled="{{busy || retry || confirmation || page * 20 >= total}}">下一页记录</button>
 <view wx:if="{{detail}}" class="card"><view class="title">报失单 {{detail.id}} · {{labels.status(detail.status)}}</view><view>{{detail.source.assetCode}} · {{detail.source.name}}</view><view>{{detail.lastSeenAt}} · {{detail.lastLocation}}</view><view>{{detail.circumstances}}</view><view>处理库管：{{detail.processorAccountId || '未认领'}}；下次复核：{{detail.nextReviewDate || '核实后填写'}}</view>
  <button wx:if="{{detail.actions.addPhoto}}" bindtap="onUpload" disabled="{{busy || retry || confirmation || stale}}">选择并上传情况图片</button>
  <view wx:for="{{detail.photos}}" wx:key="objectId"><view>{{item.filename}}</view><button data-id="{{item.objectId}}" bindtap="onPhoto" disabled="{{busy || retry || confirmation || stale}}">查看原件</button></view>
  <view wx:if="{{photoPath}}"><image src="{{photoPath}}" mode="widthFix" /><view>{{photoName}}</view><button bindtap="onClosePhoto">关闭原件</button></view>
  <view wx:if="{{detail.actions.decide || detail.actions.cancel}}"><view>本次原因（至少3字）</view><textarea value="{{reason}}" data-field="reason" bindinput="onField" maxlength="1000" disabled="{{busy || retry || confirmation || stale}}" /></view>
  <button wx:if="{{detail.actions.decide}}" data-action="approve" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">批准核实</button><button wx:if="{{detail.actions.decide}}" data-action="reject" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">驳回报告</button><button wx:if="{{detail.actions.cancel}}" data-action="cancel" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">撤回报告</button><button wx:if="{{detail.actions.claim}}" data-action="claim" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">认领核实任务</button>
  <view wx:if="{{detail.actions.search}}"><view>最后保管人核实结果（至少10字）</view><textarea value="{{custodianVerification}}" data-field="custodianVerification" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}" /><view>查找范围与线索（至少10字）</view><textarea value="{{searchedScope}}" data-field="searchedScope" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}" />
   <view>实际查找日期与当地时间</view><picker mode="date" value="{{searchDate}}" data-field="searchDate" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{searchDate || '选择日期'}}</view></picker><picker mode="time" value="{{searchTime}}" data-field="searchTime" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{searchTime || '选择时间'}}</view></picker><button data-kind="search" bindtap="onNow" disabled="{{busy || retry || confirmation || stale}}">记录当前实际查找时刻</button><view>下次复核日</view><picker mode="date" value="{{nextReviewDate}}" data-field="nextReviewDate" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{nextReviewDate || '选择复核日'}}</view></picker><button data-action="search" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">记录核实并进入查找</button>
  </view><view wx:if="{{detail.status === 'SEARCHING'}}" class="hint">继续查找仍在处理中，原责任与资产锁继续保留。</view>
  <view wx:for="{{detail.history}}" wx:key="id" class="hint">{{item.occurred_at}} · {{item.actor_username}} · {{item.action}}</view>
 </view><navigator url="/pages/request-center/index">返回业务申请</navigator>
</view>
