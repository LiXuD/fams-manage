<wxs module="labels">
var names={PENDING_ADMIN_DECISION:'待管理员确认',WAITING_WAREHOUSE_CLAIM:'待库管领取',VERIFYING:'核实中',SEARCHING:'查找中',RECOVERED:'查找中已找回',COMPLETED:'找回已完成',CONFIRMED_LOST:'已确认遗失·持续跟进',REJECTED:'已驳回',CANCELLED:'已撤回'};
module.exports={status:function(value){return names[value]||value;}};
</wxs>
<view class="page">
 <view class="title">报失与查找</view><view class="subtitle">提交只锁定资产；批准后核实查找，原责任与借用保留。</view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="hint">{{notice}}</view>
 <button bindtap="onRefresh" disabled="{{busy || confirmation}}">刷新并只读核对</button><view wx:if="{{retry}}" class="hint">原操作待确认：{{pendingLabel}}</view><button wx:if="{{retry}}" bindtap="onRetry" disabled="{{busy}}">使用原操作重试</button>
 <view wx:if="{{confirmation}}" class="card"><view>{{confirmation}}</view><button bindtap="onConfirm" disabled="{{busy}}">确认办理</button><button bindtap="onCancel" disabled="{{busy}}">返回修改</button></view>
 <button data-mode="all" bindtap="onMode" disabled="{{busy || retry || confirmation}}">全部报失</button><button data-mode="followups" bindtap="onMode" disabled="{{busy || retry || confirmation}}">遗失跟进清单</button>
 <view wx:if="{{!followUpOnly}}" class="card"><view class="title">发起报失</view>
  <view wx:for="{{assets}}" wx:key="id"><view>{{item.assetCode}} · {{item.name}}</view><button bindtap="onAsset" data-id="{{item.id}}" disabled="{{busy || retry || confirmation || stale}}">{{selectedAsset === item.id ? '已选择' : '选择此资产'}}</button></view>
  <button bindtap="onPage" data-kind="assets" data-delta="-1" disabled="{{busy || retry || confirmation || assetPage <= 1}}">上一页资产</button><button bindtap="onPage" data-kind="assets" data-delta="1" disabled="{{busy || retry || confirmation || assetPage * 20 >= assetTotal}}">下一页资产</button>
  <view>最后见到日期与当地时间</view><picker mode="date" value="{{lastDate}}" data-field="lastDate" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{lastDate || '选择日期'}}</view></picker><picker mode="time" value="{{lastTime}}" data-field="lastTime" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{lastTime || '选择时间'}}</view></picker><button data-kind="last" bindtap="onNow" disabled="{{busy || retry || confirmation || stale}}">确认为当前实际时刻</button>
  <view>最后位置</view><input value="{{lastLocation}}" data-field="lastLocation" bindinput="onField" maxlength="500" disabled="{{busy || retry || confirmation || stale}}" />
  <view>找不到的实际情况（至少10字）</view><textarea value="{{circumstances}}" data-field="circumstances" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}" />
  <button data-action="submit" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">提交报失</button>
 </view>
 <view class="title">报失记录（{{total}}）</view><view wx:for="{{rows}}" wx:key="id" class="card"><view>{{item.source.assetCode}} · {{item.source.name}}</view><view>{{labels.status(item.status)}}</view><view wx:if="{{followUpOnly}}">原责任：{{item.source.responsibleEmployeeId || item.source.departmentResponsibleEmployeeId || '在库保管'}}；跟进库管：{{item.processorAccountId}}；下次跟进：{{item.nextReviewDate}}</view><button data-id="{{item.id}}" bindtap="onOpen" disabled="{{busy || retry || confirmation || stale}}">查看报失单 {{item.id}}</button></view>
 <button data-kind="reports" data-delta="-1" bindtap="onPage" disabled="{{busy || retry || confirmation || page <= 1}}">上一页记录</button><button data-kind="reports" data-delta="1" bindtap="onPage" disabled="{{busy || retry || confirmation || page * 20 >= total}}">下一页记录</button>
 <view wx:if="{{detail}}" class="card"><view class="title">报失单 {{detail.id}} · {{labels.status(detail.status)}}</view><view>{{detail.source.assetCode}} · {{detail.source.name}}</view><view>{{detail.lastSeenAt}} · {{detail.lastLocation}}</view><view>{{detail.circumstances}}</view><view>处理库管：{{detail.processorAccountId || '未认领'}}；下次复核：{{detail.nextReviewDate || '核实后填写'}}</view>
  <button wx:if="{{detail.actions.addPhoto}}" bindtap="onUpload" disabled="{{busy || retry || confirmation || stale}}">选择并上传情况图片</button>
  <view wx:for="{{detail.photos}}" wx:key="objectId"><view>{{item.filename}}</view><button data-id="{{item.objectId}}" bindtap="onPhoto" disabled="{{busy || retry || confirmation || stale}}">查看原件</button></view>
  <view wx:if="{{photoPath}}"><image src="{{photoPath}}" mode="widthFix" /><view>{{photoName}}</view><button bindtap="onClosePhoto">关闭原件</button></view>
  <view wx:if="{{detail.actions.decide || detail.actions.cancel}}"><view>本次原因（至少3字）</view><textarea value="{{reason}}" data-field="reason" bindinput="onField" maxlength="1000" disabled="{{busy || retry || confirmation || stale}}" /></view>
  <button wx:if="{{detail.actions.decide}}" data-action="approve" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">批准核实</button><button wx:if="{{detail.actions.decide}}" data-action="reject" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">驳回报告</button><button wx:if="{{detail.actions.cancel}}" data-action="cancel" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">撤回报告</button><button wx:if="{{detail.actions.claim}}" data-action="claim" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">认领核实任务</button>
  <view wx:if="{{detail.actions.search || detail.actions.confirmLost}}"><view>最后保管人核实结果（至少10字）</view><textarea value="{{custodianVerification}}" data-field="custodianVerification" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}" /><view>查找范围与线索（至少10字）</view><textarea value="{{searchedScope}}" data-field="searchedScope" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}" />
   <view>实际查找日期与当地时间</view><picker mode="date" value="{{searchDate}}" data-field="searchDate" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{searchDate || '选择日期'}}</view></picker><picker mode="time" value="{{searchTime}}" data-field="searchTime" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{searchTime || '选择时间'}}</view></picker><button data-kind="search" bindtap="onNow" disabled="{{busy || retry || confirmation || stale}}">记录当前实际查找时刻</button><view wx:if="{{detail.actions.search}}">下次复核日</view><picker wx:if="{{detail.actions.search}}" mode="date" value="{{nextReviewDate}}" data-field="nextReviewDate" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{nextReviewDate || '选择复核日'}}</view></picker><button wx:if="{{detail.actions.search}}" data-action="search" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">记录核实并进入查找</button>
   <view wx:if="{{detail.actions.confirmLost}}"><view>相关交接、维修及盘点线索（至少10字）</view><textarea value="{{relatedClues}}" data-field="relatedClues" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}"/><view>无法找回的判断理由（至少10字）</view><textarea value="{{inabilityReason}}" data-field="inabilityReason" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}"/><view>责任证据（至少10字）</view><textarea value="{{responsibilityEvidence}}" data-field="responsibilityEvidence" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}"/>
    <view>确认遗失实际时间</view><picker mode="date" value="{{confirmDate}}" data-field="confirmDate" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{confirmDate || '选择日期'}}</view></picker><picker mode="time" value="{{confirmTime}}" data-field="confirmTime" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{confirmTime || '选择时间'}}</view></picker><button data-kind="confirm" bindtap="onNow" disabled="{{busy || retry || confirmation || stale}}">记录当前确认时刻</button><button data-action="confirmLost" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">凭证据确认遗失</button></view>
  </view><view wx:if="{{detail.status === 'SEARCHING'}}" class="hint">继续查找仍在处理中，原责任与资产锁继续保留。</view>
  <view wx:if="{{detail.status === 'CONFIRMED_LOST' && !detail.recoveredAt}}" class="hint">已确认遗失，本次查找单已结案；原责任和借用仍在，持续跟进。确认时间：{{detail.confirmedLostAt}}；最近跟进：{{detail.lastFollowUpAt || '尚未跟进'}}</view>
  <view wx:if="{{detail.actions.followUp}}"><view>本次跟进结果（至少10字）</view><textarea value="{{findings}}" data-field="findings" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}"/><view>继续保留或延期原因（至少3字）</view><textarea value="{{reason}}" data-field="reason" bindinput="onField" maxlength="1000" disabled="{{busy || retry || confirmation || stale}}"/><view>实际复核时间</view><picker mode="date" value="{{reviewDate}}" data-field="reviewDate" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{reviewDate || '选择日期'}}</view></picker><picker mode="time" value="{{reviewTime}}" data-field="reviewTime" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{reviewTime || '选择时间'}}</view></picker><button data-kind="review" bindtap="onNow" disabled="{{busy || retry || confirmation || stale}}">记录当前复核时刻</button><view>下次跟进日（留空默认30自然日后）</view><picker mode="date" value="{{nextReviewDate}}" data-field="nextReviewDate" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{nextReviewDate || '默认30自然日后'}}</view></picker><button data-action="followUp" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">记录持续跟进</button></view>
  <view wx:if="{{detail.recoveryAsset || detail.recoveredAt || detail.recoveriesTotal}}" class="card"><view class="title">原责任、原地、完好找回</view><view>已确认遗失须新建找回申请，重新批准并取得新的唯一处理权。责任、位置或状况变化需关联处理。</view><view wx:if="{{detail.recoveredAt}}">实物已找回：{{detail.recoveredAt}}；历史遗失事实保留。</view>
   <view wx:if="{{detail.recoveryAsset}}"><view>登记位置：{{detail.recoveryAsset.locationName}}；登记序列号：{{detail.recoveryAsset.serialNumber || '未登记'}}</view><view>实际原机编码</view><input value="{{observedAssetCode}}" data-field="observedAssetCode" bindinput="onField" maxlength="64" disabled="{{busy || retry || confirmation || stale}}"/><view>实际原机序列号（登记有值时必填）</view><input value="{{observedSerialNumber}}" data-field="observedSerialNumber" bindinput="onField" maxlength="128" disabled="{{busy || retry || confirmation || stale}}"/><view>实际找回日期和当地时间</view><picker mode="date" value="{{foundDate}}" data-field="foundDate" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{foundDate || '选择日期'}}</view></picker><picker mode="time" value="{{foundTime}}" data-field="foundTime" bindchange="onField" disabled="{{busy || retry || confirmation || stale}}"><view>{{foundTime || '选择时间'}}</view></picker><button data-kind="found" bindtap="onNow" disabled="{{busy || retry || confirmation || stale}}">记录当前实际找回时刻</button><view>找回实物与原保管证据（至少10字）</view><textarea value="{{recoveryEvidence}}" data-field="recoveryEvidence" bindinput="onField" maxlength="2000" disabled="{{busy || retry || confirmation || stale}}"/><view><switch checked="{{recoveryChecked}}" bindchange="onRecoveryChecked" disabled="{{busy || retry || confirmation || stale}}"/>已对照原机身份，亲见完好实物仍由原责任人在登记位置保管</view></view>
   <button wx:if="{{detail.actions.recoverOriginal}}" data-action="recoverOriginal" bindtap="onRecoveryPrepare" disabled="{{busy || retry || confirmation || stale}}">核实原机并结束查找</button><button wx:if="{{detail.actions.requestRecovery}}" data-action="requestRecovery" bindtap="onRecoveryPrepare" disabled="{{busy || retry || confirmation || stale}}">新建找回申请</button><view>近期找回申请 {{detail.recoveriesTotal || 0}} 项（最多20项，包含当前在办项）</view>
   <view wx:for="{{detail.recoveries}}" wx:key="id"><view>找回申请 {{item.id}} · {{labels.status(item.status)}}；新处理库管：{{item.processorAccountId || '未认领'}}</view><view wx:if="{{item.actions.decide || item.actions.cancel}}">本次找回审批/撤回原因<textarea value="{{reason}}" data-field="reason" bindinput="onField" maxlength="1000" disabled="{{busy || retry || confirmation || stale}}"/></view><button wx:if="{{item.actions.decide}}" data-action="approve" data-id="{{item.id}}" bindtap="onRecoveryPrepare" disabled="{{busy || retry || confirmation || stale}}">批准找回申请</button><button wx:if="{{item.actions.decide}}" data-action="reject" data-id="{{item.id}}" bindtap="onRecoveryPrepare" disabled="{{busy || retry || confirmation || stale}}">驳回找回申请</button><button wx:if="{{item.actions.cancel}}" data-action="cancel" data-id="{{item.id}}" bindtap="onRecoveryPrepare" disabled="{{busy || retry || confirmation || stale}}">撤回找回申请</button><button wx:if="{{item.actions.claim}}" data-action="claim" data-id="{{item.id}}" bindtap="onRecoveryPrepare" disabled="{{busy || retry || confirmation || stale}}">重新认领找回任务</button><button wx:if="{{item.actions.execute}}" data-action="execute" data-id="{{item.id}}" bindtap="onRecoveryPrepare" disabled="{{busy || retry || confirmation || stale}}">核实原机并完成找回</button></view>
  </view>
  <view wx:for="{{detail.history}}" wx:key="id" class="hint">{{item.occurred_at}} · {{item.actor_username}} · {{item.action}}</view>
 </view><navigator url="/pages/request-center/index">返回业务申请</navigator>
</view>
