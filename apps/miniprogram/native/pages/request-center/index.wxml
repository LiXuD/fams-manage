<wxs module="labels">
var names = {DRAFT:'草稿',PENDING_ADMIN_DECISION:'待管理员确认',REJECTED:'已驳回',WAITING_WAREHOUSE_CLAIM:'待库管领取',WAREHOUSE_PROCESSING:'库管处理中',WAITING_HANDOVER:'待交接',PARTIALLY_COMPLETED:'部分完成',COMPLETED:'已完成',UNFULFILLABLE:'无法满足',CANCELLED:'已取消'};
var reasons = {STOCK_SHORTAGE:'库存不足',SPECIFICATION_MISMATCH:'规格不匹配',TEMPORARILY_UNAVAILABLE:'暂不可用',OTHER:'其他'};
module.exports = {status:function(value){return names[value] || value;},reason:function(value){return reasons[value] || value;}};
</wxs>
<view class="page">
  <view class="title">领用与借用申请</view>
  <view class="subtitle">按数量申请，不需选择资产编码。批准后由库管分配实物。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="hint">{{notice}}</view>
  <button bindtap="onNew" disabled="{{busy || retryable}}">新建申请</button>
  <button bindtap="onRefresh" disabled="{{busy}}">刷新结果</button>
  <button wx:if="{{retryable}}" bindtap="onRetry" disabled="{{busy}}">重试上次操作</button>
  <view wx:for="{{rows}}" wx:key="id" class="card"><view class="value">{{item.requestNo}}</view>
    <view>{{labels.status(item.requestStatus)}} · {{item.creatorUsernameSnapshot}}</view>
    <button data-id="{{item.id}}" bindtap="onOpen" disabled="{{busy || retryable}}">查看申请</button></view>
  <view wx:if="{{!rows.length && !busy}}" class="hint">当前没有可见申请。</view>
  <button wx:if="{{page > 1}}" bindtap="onPrevious" disabled="{{busy || retryable}}">上一页申请</button>
  <button wx:if="{{page * 20 < total}}" bindtap="onNext" disabled="{{busy || retryable}}">下一页申请</button>
  <view wx:if="{{showForm}}">
    <button bindtap="onRequestType" disabled="{{busy || retryable || mode === 'change'}}">申请类型：{{requestType === 'BORROW' ? '借用' : '领用'}}</button>
    <view wx:if="{{requestType === 'BORROW'}}" class="card"><view class="label">预计归还日</view>
      <picker mode="date" value="{{expectedReturnDate}}" bindchange="onReturnDate" disabled="{{busy || retryable || mode === 'change'}}">
        <view class="value">{{expectedReturnDate || '请选择预计归还日'}}</view></picker></view>
    <view class="title">{{mode === 'new' ? '新建申请' : mode === 'change' ? '提请范围变更' : '修改草稿'}}</view>
    <view wx:for="{{form}}" wx:for-item="d" wx:for-index="i" wx:key="index" class="card">
      <view class="label">需求 {{i + 1}} · 分类</view>
      <picker range="{{categories}}" range-key="name" value="{{d.categoryIndex}}" data-index="{{i}}" data-field="category" bindchange="onPick" disabled="{{busy || retryable}}"><view class="value">{{categories[d.categoryIndex].name}}</view></picker>
      <view class="label">规格</view><input value="{{d.specification}}" maxlength="1000" data-index="{{i}}" data-field="specification" bindinput="onField" disabled="{{busy || retryable}}" />
      <view class="label">数量</view><input type="number" value="{{d.quantity}}" data-index="{{i}}" data-field="quantity" bindinput="onField" disabled="{{busy || retryable}}" />
      <view class="label">用途</view><input value="{{d.purpose}}" maxlength="1000" data-index="{{i}}" data-field="purpose" bindinput="onField" disabled="{{busy || retryable}}" />
      <view class="label">期望日期</view><picker mode="date" value="{{d.expectedDate}}" data-index="{{i}}" data-field="expectedDate" bindchange="onField" disabled="{{busy || retryable}}"><view class="value">{{d.expectedDate}}</view></picker>
      <view class="label">偏好品牌（不代表库存承诺）</view><input value="{{d.preferredBrand}}" maxlength="128" data-index="{{i}}" data-field="preferredBrand" bindinput="onField" disabled="{{busy || retryable}}" />
      <view class="label">偏好型号</view><input value="{{d.preferredModel}}" maxlength="128" data-index="{{i}}" data-field="preferredModel" bindinput="onField" disabled="{{busy || retryable}}" />
      <view class="label">{{d.custodyType === 'PERSONAL' ? '个人使用' : '部门公用'}}</view>
      <button wx:if="{{canApplyShared}}" data-index="{{i}}" bindtap="onCustody" disabled="{{busy || retryable}}">切换个人 / 部门公用</button>
      <view class="label">使用组织</view><picker range="{{organizations}}" range-key="name" value="{{d.organizationIndex}}" data-index="{{i}}" data-field="organization" bindchange="onPick" disabled="{{busy || retryable}}"><view class="value">{{organizations[d.organizationIndex].name}}</view></picker>
      <view class="label">{{d.custodyType === 'PERSONAL' ? '实际使用人' : '部门责任人'}}</view><picker range="{{d.employeeChoices}}" range-key="name" value="{{d.employeeIndex}}" data-index="{{i}}" data-field="employee" bindchange="onPick" disabled="{{busy || retryable}}"><view class="value">{{d.employeeChoices[d.employeeIndex].name}}</view></picker>
      <view class="label">固定位置</view><picker range="{{locations}}" range-key="name" value="{{d.locationIndex}}" data-index="{{i}}" data-field="location" bindchange="onPick" disabled="{{busy || retryable}}"><view class="value">{{locations[d.locationIndex].name}}</view></picker>
      <button wx:if="{{form.length > 1 && mode !== 'change'}}" data-index="{{i}}" bindtap="onRemove" disabled="{{busy || retryable}}">移除此需求</button>
    </view>
    <button wx:if="{{mode !== 'change' && form.length < 50}}" bindtap="onAdd" disabled="{{busy || retryable}}">增加需求</button>
    <button class="primary" bindtap="onSave" disabled="{{busy || retryable}}">{{mode === 'change' ? '提请变更确认' : '保存草稿'}}</button>
  </view>
  <view wx:if="{{selected && !showForm}}" class="card">
    <view class="value">{{selected.requestNo}}</view><view>{{labels.status(selected.requestStatus)}}</view>
    <view wx:if="{{selected.sourceRequestId}}" class="hint">来源申请 {{selected.sourceRequestId}} / 需求 {{selected.sourceDemandId}}</view>
    <view wx:for="{{selected.demands}}" wx:key="id" class="card"><view class="label">{{item.categoryNameSnapshot}} · {{item.specification}}</view>
      <view>{{item.purpose}} · 期望 {{item.expectedDate}}</view>
      <view>申请 {{item.requestedQuantity}} / 待分配 {{item.pendingAllocationQuantity}} / 待交接 {{item.pendingHandoverQuantity}} / 已完成 {{item.completedQuantity}} / 无法满足 {{item.unfulfillableQuantity}} / 已取消 {{item.cancelledQuantity}}</view>
      <button wx:if="{{selected.creatorAccountId === accountId && item.unfulfillableQuantity > 0}}" data-id="{{item.id}}" bindtap="onFollowup" disabled="{{busy || retryable}}">就此部分重新申请 / 查看最新后续</button>
    </view>
    <view wx:for="{{selected.decisions}}" wx:key="id" class="hint">版本 {{item.requestVersion}}：{{item.decisionResult === 'APPROVED' ? '批准' : '驳回'}} {{item.commentText}}</view>
    <view wx:for="{{selected.unfulfillable}}" wx:key="id" class="hint">无法满足 {{item.quantity}} 件：{{labels.reason(item.reasonCode)}} {{item.reasonDescription}}；当时可用 {{item.inventoryQuerySummaryJson.availableCount}} 件。</view>
    <view wx:for="{{selected.allocations}}" wx:key="id" class="hint">{{item.assetSnapshotJson.assetCode}} · {{item.assetSnapshotJson.name}} · {{item.allocationStatus === 'WAITING_DELIVERY' ? '待交出' : item.allocationStatus === 'CANCELLED' ? '已取消分配（保留历史）' : item.allocationStatus}}</view>
    <button wx:if="{{selected.creatorAccountId === accountId && (selected.requestStatus === 'DRAFT' || selected.requestStatus === 'REJECTED')}}" bindtap="onRevise" disabled="{{busy || retryable}}">修改草稿</button>
    <button wx:if="{{selected.creatorAccountId === accountId && selected.requestStatus === 'DRAFT'}}" class="primary" bindtap="onSubmit" disabled="{{busy || retryable}}">提交管理员确认</button>
    <button wx:if="{{selected.creatorAccountId === accountId && (selected.requestStatus === 'WAITING_WAREHOUSE_CLAIM' || selected.requestStatus === 'WAREHOUSE_PROCESSING' || selected.requestStatus === 'WAITING_HANDOVER')}}" bindtap="onChange" disabled="{{busy || retryable}}">提请范围变更</button>
    <view class="label">取消或通知核查说明</view><input value="{{reason}}" maxlength="1000" bindinput="onReason" disabled="{{busy || retryable}}" />
    <button wx:if="{{selected.creatorAccountId === accountId && (selected.requestStatus === 'DRAFT' || selected.requestStatus === 'REJECTED' || (selected.requestStatus === 'PENDING_ADMIN_DECISION' && !selected.decisions.length))}}" bindtap="onCancel" disabled="{{busy || retryable || !reason}}">取消申请</button>
    <button wx:if="{{selected.creatorAccountId === accountId}}" bindtap="onDispute" disabled="{{busy || retryable || !reason}}">通知管理员核查无法满足结果</button>
    <view class="hint">分配后仍为待交接；未交出资产不提供接收按钮。</view>
  </view>
  <navigator url="/pages/mine/index" open-type="redirect">返回我的账号</navigator>
</view>

<navigator url="/pages/repairs/index">报修与内部维修（按当前权限）</navigator>
