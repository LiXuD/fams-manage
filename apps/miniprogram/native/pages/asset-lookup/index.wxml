<view class="page">
  <view class="title">资产查询</view>
  <view class="label">资产编码</view>
  <input value="{{code}}" bindinput="onCode" maxlength="128" disabled="{{busy}}" aria-label="资产编码" />
  <button bindtap="onSearch" disabled="{{busy || !code}}">查询资产</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{busy}}" class="hint">正在查询</view>
  <view wx:if="{{result}}" class="card">
    <view class="value">{{result.asset.assetCode}} · {{result.asset.name}}</view>
    <view>当前状态 {{status}}</view>
    <view class="label">时间线履历</view>
    <view wx:if="{{!result.timeline.length}}" class="hint">当前页没有可见履历。</view>
    <view wx:for="{{result.timeline}}" wx:key="id">{{item.occurredAt}} · {{item.summary || item.eventType}}</view>
    <button wx:if="{{result.page > 1}}" bindtap="onPrevious">上一页履历</button>
    <button wx:if="{{result.more}}" bindtap="onNext">下一页履历</button>
  </view>
</view>
