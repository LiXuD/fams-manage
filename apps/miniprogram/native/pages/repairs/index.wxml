<wxs module="labels">var states={PENDING_ADMIN_DECISION:'待管理员确认',WAITING_WAREHOUSE_CLAIM:'待库管领取',WAREHOUSE_PROCESSING:'库管处理中',COMPLETED:'维修已完成',REJECTED:'已驳回',CANCELLED:'已取消',PENDING:'待管理员确认返厂范围',APPROVED:'已批准无费用返厂',WITHDRAWN:'范围已撤回',PENDING_DISPATCH:'待寄出',DISPATCHED:'已寄出，待原机收回',RECEIVED:'原机已实际收回'}; module.exports={state:function(s){return states[s]||s;}};</wxs>
<view class="page"><view class="title">报修与内部维修</view><view class="hint">按实际去向办理内部零费用维修；实物离开过原保管人时不能直接原地恢复，回库须实际验收。</view>
<navigator url="/pages/repair-return-sources/index">管理员：损坏归还接续维修</navigator>
<view wx:if="{{error}}" class="error" role="alert">{{error}}</view><button bindtap="onRefresh" disabled="{{busy}}">刷新核对</button><button wx:if="{{retry}}" bindtap="onRetry" disabled="{{busy}}">用原操作重试</button>
<view wx:for="{{rows}}" wx:key="id" class="card"><view>{{item.source.assetCode}} · {{item.source.name}} · {{labels.state(item.status)}}</view><button data-id="{{item.id}}" bindtap="onOpen" disabled="{{busy || retry}}">查看维修 {{item.id}}</button></view>
<button wx:if="{{page > 1}}" data-delta="-1" bindtap="onPage" disabled="{{busy || retry}}">上一页维修</button><button wx:if="{{page * 20 < total}}" data-delta="1" bindtap="onPage" disabled="{{busy || retry}}">下一页维修</button>
<view class="card"><view class="title">新报修</view><view wx:for="{{assets}}" wx:key="id"><button data-id="{{item.id}}" bindtap="onAsset" disabled="{{busy || retry}}">{{selectedAsset === item.id ? '已选：' : '选择：'}}{{item.assetCode}} · {{item.name}} · {{item.locationName}}</button></view>
<button wx:if="{{assetPage > 1}}" data-kind="assets" data-delta="-1" bindtap="onPage" disabled="{{busy || retry}}">上一页资产</button><button wx:if="{{assetPage * 20 < assetTotal}}" data-kind="assets" data-delta="1" bindtap="onPage" disabled="{{busy || retry}}">下一页资产</button>
<view>实际故障</view><textarea value="{{fault}}" data-field="fault" bindinput="onField" maxlength="2000" disabled="{{busy || retry}}"/><view>影响程度：{{impact}}</view><picker range="{{['轻度','中度','严重']}}" bindchange="onImpact" disabled="{{busy || retry}}"><view>选择影响程度</view></picker>
<view>实际发生时间（例如2026-10-21T09:00:00+08:00）</view><input value="{{occurredAt}}" data-field="occurredAt" bindinput="onField" disabled="{{busy || retry}}"/><button bindtap="onSubmit" disabled="{{busy || retry || !selectedAsset}}">提交报修</button></view>
<view wx:if="{{detail}}" class="card"><view class="title">维修 {{detail.id}}</view><view>{{detail.source.assetCode}} · {{detail.source.name}} · {{labels.state(detail.status)}}</view><view>{{detail.fault}}</view>
<view wx:if="{{detail.factorySummary}}" class="card"><view class="title">返厂共同进度</view><view wx:if="{{detail.factorySummary.scope}}">{{labels.state(detail.factorySummary.scope.scopeStatus)}}</view><view>已实际寄出 {{detail.factorySummary.actualDispatchCount}} 次</view><view wx:if="{{detail.factorySummary.round}}">第{{detail.factorySummary.round.roundNumber}}轮 · {{labels.state(detail.factorySummary.round.roundStatus)}} · 预计收回 {{detail.factorySummary.round.expectedReturnDate}}</view></view>
<button wx:if="{{detail.actions.manageFactory}}" bindtap="onFactory" disabled="{{busy || retry}}">返厂范围与原机轮次</button>
<view wx:for="{{detail.inventoryEvidence}}" wx:for-item="origin" wx:key="observationId"><navigator wx:if="{{!busy &amp;&amp; !retry}}" url="/pages/repair-inventory-evidence/index?repairId={{detail.id}}&amp;observationId={{origin.observationId}}">读取盘点 {{origin.taskId}} 的原始损坏照片</navigator></view>
<button wx:if="{{detail.actions.addFaultPhoto}}" bindtap="onUpload" disabled="{{busy || retry}}">上传故障照片</button><button wx:for="{{detail.photos}}" wx:key="objectId" data-id="{{item.objectId}}" bindtap="onPhoto" disabled="{{busy || retry}}">查看照片 {{item.filename}}</button>
<view wx:if="{{photoPath}}"><image src="{{photoPath}}" mode="widthFix"/><view>{{photoName}}</view><button bindtap="onClosePhoto">关闭照片并清理</button></view>
<view wx:if="{{detail.actions.approve || detail.actions.cancel}}"><view>处理依据</view><textarea value="{{reason}}" data-field="reason" bindinput="onField" maxlength="1000" disabled="{{busy || retry}}"/></view>
<picker wx:if="{{detail.actions.approve}}" range="{{['仅内部无费用处理','内部或必要时返厂（无费用）']}}" value="{{approvalMethodIndex}}" bindchange="onApprovalMethod" disabled="{{busy || retry}}"><view>本次批准处理方式：{{approvalMethodIndex === 1 ? '内部或必要时返厂（无费用）' : '仅内部无费用处理'}}</view></picker>
<button wx:if="{{detail.actions.approve}}" data-action="approve" bindtap="onAction" disabled="{{busy || retry}}">{{approvalMethodIndex === 1 ? '一次批准内部及必要返厂范围' : '批准内部零费用维修'}}</button><button wx:if="{{detail.actions.approve}}" data-action="reject" bindtap="onAction" disabled="{{busy || retry}}">驳回</button><button wx:if="{{detail.actions.cancel}}" data-action="cancel" bindtap="onAction" disabled="{{busy || retry}}">取消报修</button><button wx:if="{{detail.actions.claim}}" data-action="claim" bindtap="onAction" disabled="{{busy || retry}}">领取维修处理权</button>
<view wx:if="{{detail.actions.acceptInPlace || detail.actions.completeInPlace}}"><view>实际扫描或核对的资产编码</view><input value="{{observedCode}}" data-field="observedCode" bindinput="onField" disabled="{{busy || retry}}"/><view>原位置：{{detail.source.locationName}}</view><checkbox-group bindchange="onPhysical"><label><checkbox value="location" checked="{{locationConfirmed}}" disabled="{{busy || retry}}"/>实物仍在上述位置</label><label><checkbox value="neverLeft" checked="{{neverLeft}}" disabled="{{busy || retry}}"/>未离开原保管方</label></checkbox-group><view>实际接修或修复依据（至少10字）</view><textarea value="{{evidence}}" data-field="evidence" bindinput="onField" maxlength="2000" disabled="{{busy || retry}}"/><button wx:if="{{detail.actions.acceptInPlace}}" data-action="accept" bindtap="onAction" disabled="{{busy || retry}}">确认实际接修</button><button wx:if="{{detail.actions.completeInPlace}}" data-action="complete" bindtap="onAction" disabled="{{busy || retry}}">确认实际修复并原地恢复</button></view>
<view wx:for="{{detail.physicalHandling}}" wx:key="occurred_at">实物已离开原保管人，实际接收 {{item.occurred_at}} · {{item.evidence}}；不能原地关闭。</view><view wx:for="{{detail.inbound}}" wx:key="occurred_at">已验收入库 {{item.occurred_at}} · {{item.evidence}}</view>
<view wx:if="{{detail.actions.acceptAway || detail.actions.closeInbound}}" class="card"><view class="title">实物接修与验收入库</view>
<button wx:if="{{detail.actions.acceptAway}}" data-mode="away" bindtap="onPhysicalMode" disabled="{{busy || retry}}">记录离开原保管人的实际接修</button><button wx:if="{{detail.actions.closeInbound}}" data-mode="inbound" bindtap="onPhysicalMode" disabled="{{busy || retry}}">核对已修复并验收入库</button><view>{{physicalMode === 'away' ? '接修后继续保留维修与资产锁' : '实际验收入库，同步关闭原未结借用及维修'}}</view>
<view wx:if="{{physicalMode === 'inbound'}}"><button data-kind="warehouse" bindtap="onPhysicalCatalog" disabled="{{busy || retry}}">查询回库仓库</button><button wx:for="{{warehouses}}" wx:key="id" data-id="{{item.id}}" bindtap="onPhysicalWarehouse" disabled="{{busy || retry}}">{{physicalWarehouseId === item.id ? '已选：' : '选择：'}}{{item.name}}</button><button wx:if="{{warehousePage > 1}}" data-kind="warehouse" data-delta="-1" bindtap="onPhysicalCatalog" disabled="{{busy || retry}}">上一页回库仓库</button><button wx:if="{{warehousePage * 20 < warehouseTotal}}" data-kind="warehouse" data-delta="1" bindtap="onPhysicalCatalog" disabled="{{busy || retry}}">下一页回库仓库</button></view>
<button data-kind="location" bindtap="onPhysicalCatalog" disabled="{{busy || retry}}">查询实物位置</button><block wx:for="{{physicalLocations}}" wx:key="id"><button wx:if="{{physicalMode === 'away' || (item.location_type === 'BIN' && item.warehouse_id === physicalWarehouseId)}}" data-id="{{item.id}}" bindtap="onPhysicalLocation" disabled="{{busy || retry}}">{{physicalLocationId === item.id ? '已选：' : '选择：'}}{{item.name}}</button></block><button wx:if="{{physicalLocationPage > 1}}" data-kind="location" data-delta="-1" bindtap="onPhysicalCatalog" disabled="{{busy || retry}}">上一页实物位置</button><button wx:if="{{physicalLocationPage * 20 < physicalLocationTotal}}" data-kind="location" data-delta="1" bindtap="onPhysicalCatalog" disabled="{{busy || retry}}">下一页实物位置</button>
<view>实物资产编码</view><input value="{{physicalObservedCode}}" data-field="physicalObservedCode" bindinput="onField" disabled="{{busy || retry}}"/><view>带时区实际接收时间</view><input value="{{physicalAt}}" data-field="physicalAt" bindinput="onField" disabled="{{busy || retry}}"/><view>实物接收及修复依据（至少10字）</view><textarea value="{{physicalEvidence}}" data-field="physicalEvidence" bindinput="onField" maxlength="2000" disabled="{{busy || retry}}"/><button bindtap="onPhysicalAction" disabled="{{busy || retry}}">核对保存本次实物办理</button></view>
<view wx:if="{{detail.actions.reassign}}" class="card"><view class="title">管理员受控转派</view><button bindtap="onReassignment" disabled="{{busy || retry}}">核对实物阶段及接任库管</button>
<view wx:if="{{reassignment}}"><view>实物阶段：{{reassignment.snapshot.outstandingReturn ? (reassignment.snapshot.outstandingReturn.handover_status === 'REFUSED' ? '已拒收，待实际收回' : '已交出，待实际接收') : reassignment.snapshot.physicalHandling.length ? '已离开原保管人' : reassignment.snapshot.acceptedAt ? '已原地接修' : '尚未接修'}}。转派不会释放资产锁或替代实物办理。</view>
<button wx:for="{{reassignment.operators}}" wx:key="id" bindtap="onReassignTarget" data-id="{{item.id}}" disabled="{{busy || retry}}">{{reassignTarget === item.id ? '已选：' : '选择：'}}{{item.name}}</button>
<view>转派原因</view><textarea value="{{reassignReason}}" data-field="reassignReason" bindinput="onField" maxlength="1000" disabled="{{busy || retry}}"/><view>实际交接凭证</view><textarea value="{{reassignEvidence}}" data-field="reassignEvidence" bindinput="onField" maxlength="2000" disabled="{{busy || retry}}"/>
<checkbox-group bindchange="onReassignChecked"><label><checkbox value="checked" checked="{{reassignChecked}}" disabled="{{busy || retry}}"/>已核对未交出、已交出、待收回、未同步结果与资产锁</label></checkbox-group><button bindtap="onReassign" disabled="{{busy || retry}}">核对保存维修转派</button></view></view>
<navigator url="/pages/target-changes/index">提请或审批维修返还目标变更</navigator>
<view wx:for="{{detail.approvedReturnTargets}}" wx:key="id">已批准返还目标：{{item.target_json.employeeName}} · {{item.target_json.organizationName}} · {{item.target_json.locationName}}</view>
<navigator wx:if="{{detail.actions.proxyReturn &amp;&amp; !busy &amp;&amp; !retry}}" url="/pages/proxy-confirmations/index?businessType=REPAIR&amp;businessId={{detail.id}}&amp;itemId={{detail.source.id}}">已实际签收但无法在线确认：申请异常代确认</navigator>
<view class="card"><view class="title">维修实际返还</view><view>实物交出后继续维修中并持锁，本次有效目标实际接收才恢复责任，批准不会代替实物接收。逾期借用先在借用台账获批延期，拒收后须库管实际收回才可回库。</view><view wx:if="{{detail.loanExpectedReturnDate}}">原借用预计归还日：{{detail.loanExpectedReturnDate}}</view>
<view wx:for="{{detail.returnHandovers}}" wx:key="id">{{item.handover_status === 'WAITING_RECEIPT' ? '已交出，待实际接收' : item.handover_status === 'REFUSED' ? '原目标拒收，待实际收回' : item.handover_status === 'RECEIVED' ? '本次目标已实际接收' : '库管已实际收回'}} · {{item.target_snapshot_json.employeeName}} · {{item.target_snapshot_json.organizationName}} · {{item.target_snapshot_json.locationName}} · {{item.delivery_evidence}}<view wx:if="{{item.receipt_at}}">{{item.receipt_at}} · {{item.receipt_evidence}}</view></view>
<view wx:for="{{detail.returnRecollections}}" wx:key="handover_id">实际收回 {{item.occurred_at}} · {{item.evidence}}</view>
<view wx:if="{{detail.actions.deliverReturn || detail.actions.receiveReturn || detail.actions.refuseReturn || detail.actions.recollectReturn}}"><button wx:if="{{detail.actions.deliverReturn}}" data-mode="delivery" bindtap="onReturnMode" disabled="{{busy || retry}}">{{detail.approvedReturnTargets.length ? "核实已批准目标并记录实际交出" : "核实原目标并记录实际交出"}}</button><button wx:if="{{detail.actions.receiveReturn}}" data-mode="receipt" bindtap="onReturnMode" disabled="{{busy || retry}}">我已实际接收修复设备</button><button wx:if="{{detail.actions.refuseReturn}}" data-mode="refusal" bindtap="onReturnMode" disabled="{{busy || retry}}">记录实际拒收及原因</button><button wx:if="{{detail.actions.recollectReturn}}" data-mode="recollection" bindtap="onReturnMode" disabled="{{busy || retry}}">核实库管已实际收回</button>
<view wx:if="{{returnTarget}}">本次有效目标：{{returnTarget.employeeName}} · {{returnTarget.organizationName}} · {{returnTarget.locationName}}</view><view wx:if="{{returnMode === 'recollection'}}"><button bindtap="onReturnCatalog" disabled="{{busy || retry}}">查询实际收回位置</button><button wx:for="{{returnLocations}}" wx:key="id" data-id="{{item.id}}" bindtap="onReturnLocation" disabled="{{busy || retry}}">{{returnLocationId === item.id ? '已选：' : '选择：'}}{{item.name}}</button><button wx:if="{{returnLocationPage > 1}}" data-delta="-1" bindtap="onReturnCatalog" disabled="{{busy || retry}}">上一页收回位置</button><button wx:if="{{returnLocationPage * 20 < returnLocationTotal}}" data-delta="1" bindtap="onReturnCatalog" disabled="{{busy || retry}}">下一页收回位置</button></view>
<view>本次实物编码</view><input value="{{returnObservedCode}}" data-field="returnObservedCode" bindinput="onField" disabled="{{busy || retry}}"/><view>本次带时区实际时间</view><input value="{{returnAt}}" data-field="returnAt" bindinput="onField" disabled="{{busy || retry}}"/><checkbox-group wx:if="{{returnMode === 'receipt' || returnMode === 'refusal'}}" bindchange="onReturnChecked"><label><checkbox value="physical" checked="{{returnChecked}}" disabled="{{busy || retry}}"/>我已亲自核实本次实物及接收决定</label></checkbox-group><view>本次实际交接或拒收依据（至少10字）</view><textarea value="{{returnEvidence}}" data-field="returnEvidence" bindinput="onField" maxlength="2000" disabled="{{busy || retry}}"/><button bindtap="onReturnAction" disabled="{{busy || retry}}">核对本次返还办理</button></view></view>
<view>最近处理记录（最多100条，共{{detail.historyTotal}}条）</view><view wx:for="{{detail.history}}" wx:key="id">{{item.actor_username}} · {{item.occurred_at}} · {{item.action}}</view></view><navigator url="/pages/mine/index">返回我的账号</navigator></view>
