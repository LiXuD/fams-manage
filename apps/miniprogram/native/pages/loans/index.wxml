<view class="page">
  <view class="title">我的资产与归还</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view wx:if="{{notice}}" class="hint">{{notice}}</view>
  <button bindtap="onRefresh" disabled="{{busy}}">刷新</button>
  <button wx:if="{{retryable}}" bindtap="onRetry" disabled="{{busy}}">重试上次操作</button>
  <view wx:for="{{loans}}" wx:key="id" class="card">
    <view>{{item.assetCode}} · {{item.name}}</view><view>预计归还 {{item.expectedReturnDate}}</view>
    <view>{{item.relationStatus === 'OPEN' ? '借用中' : item.relationStatus === 'RETURNED' ? '已归还' : item.relationStatus === 'LOST_TERMINATED' ? '遗失终止' : item.relationStatus === 'VOID' ? '已撤销' : item.relationStatus}} {{item.overdue ? '· 已逾期' : ''}}</view>
    <button data-id="{{item.id}}" bindtap="onSelect" disabled="{{busy || retryable}}">查看 / 延期 / 归还</button>
  </view>
  <view wx:if="{{!loans.length}}" class="hint">当前范围没有借用记录。</view>
  <view wx:if="{{selected}}" class="card">
    <view>{{selected.assetCode}} · {{selected.name}}</view>
    <view>借出日 {{selected.borrowedDate}}</view><view>原归还日 {{selected.originalReturnDate}}</view><view>当前归还日 {{selected.expectedReturnDate}}</view>
    <view wx:if="{{selected.lostLiability}}">已确认遗失，保留责任追踪。</view>
    <view wx:for="{{selected.reminders}}" wx:key="id">提醒 {{item.reminderBusinessDate}} · {{item.reminderType}}
      <view wx:if="{{item.overdueFrom}}">逾期起始 {{item.overdueFrom}}</view></view>
    <view wx:for="{{selected.extensions}}" wx:key="id">延期至 {{item.requestedDueDate}} · {{item.extensionStatus}}
      <view wx:if="{{item.overdueFrom}}">历史逾期 {{item.overdueFrom}} 至 {{item.overdueThrough}}</view>
    </view>
    <view wx:if="{{selected.relationStatus === 'OPEN'}}">
      <picker mode="date" value="{{dueDate}}" bindchange="onDueDate" disabled="{{busy || retryable}}"><view class="input">新的归还日期：{{dueDate || '请选择'}}</view></picker>
      <textarea value="{{reason}}" bindinput="onReason" maxlength="1000" placeholder="填写延期或归还原因" disabled="{{busy || retryable}}" />
      <button bindtap="onExtend" disabled="{{busy || retryable}}">提请延期</button><button bindtap="onReturn" disabled="{{busy || retryable}}">申请归还</button>
    </view>
  </view>
  <view class="title">可退库资产</view>
  <view wx:for="{{assets}}" wx:key="id" class="card"><view>{{item.assetCode}} · {{item.name}}</view>
    <button data-id="{{item.id}}" bindtap="onSelectAsset" disabled="{{busy || retryable}}">选择退库资产</button></view>
  <view wx:if="{{selectedAsset}}" class="card"><view>{{selectedAsset.assetCode}} · {{selectedAsset.name}}</view>
    <textarea value="{{reason}}" bindinput="onReason" maxlength="1000" placeholder="填写退库原因" disabled="{{busy || retryable}}" />
    <button bindtap="onReturn" disabled="{{busy || retryable}}">提请退库</button></view>
  <view class="title">退还进度</view>
  <view wx:for="{{returns}}" wx:key="id" class="card"><view>退还 {{item.id}} · {{item.returnStatus}}</view><view>{{item.reason}}</view><view wx:if="{{item.returnLossReport}}">关联报失 {{item.returnLossReport.reportId}} · {{item.returnLossReport.recovered ? '实物已找回' : item.returnLossReport.status === 'REJECTED' ? '已驳回' : item.returnLossReport.status === 'CANCELLED' ? '已撤回' : '查看后续进度'}}</view>
    <view wx:if="{{item.inspectionResult}}">验收 {{item.inspectionResult}} · {{item.inspectionReason}}</view><button data-id="{{item.id}}" bindtap="onReturnProgress" disabled="{{busy || retryable}}">核对后续实际进度</button>
  </view>
  <view wx:if="{{returnProgress}}" class="card"><view>原归还 {{returnProgress.id}} 的后续义务</view><view wx:if="{{returnProgress.lossRecovery}}">找回关联退库：历史报失 {{returnProgress.lossRecovery.reportId}}；原责任与借用保留至实物验收，驳回仍保锁。</view><view wx:if="{{returnProgress.lossRecovery &amp;&amp; returnProgress.returnStatus==='REJECTED'}}"><textarea value="{{reason}}" bindinput="onReason" placeholder="补充重送原因（须管理员办理）" disabled="{{busy || retryable}}"/><button bindtap="onResubmitLossReturn" disabled="{{busy || retryable}}">管理员重新送审退库</button></view><view wx:for="{{returnProgress.followups}}" wx:key="id">{{item.businessType === 'REPAIR' ? '损坏维修' : '报失处理'}} · {{item.followupStatus === 'CLOSED' ? '已实际完成' : item.followupStatus === 'ACCEPTED' ? '正式处理中' : '待继续处理'}}<view wx:if="{{item.linkedRepairId || item.lastRepairId}}">正式维修 {{item.linkedRepairId || item.lastRepairId}} · {{item.repairStatus === 'COMPLETED' ? '已验收入库' : '原维修尚未实际完成'}}</view><view wx:if="{{item.lossReport}}">报失 {{item.lossReport.reportId}} · {{item.lossReport.recovered ? '实物已找回' : item.lossReport.status === 'REJECTED' ? '已驳回' : item.lossReport.status === 'CANCELLED' ? '已撤回' : '正式报失'}}<button data-id="{{item.lossReport.reportId}}" bindtap="onOpenMissingLoss" disabled="{{busy || retryable}}">查看报失进度</button></view>
  <view wx:if="{{item.recoveryReturnStatus}}">找回关联退还：{{item.recoveryReturnStatus === 'COMPLETED' ? '已验收入库' : '尚未验收入库'}}</view>
  <view wx:if="{{item.canRetryMissingLoss}}"><view>原归还保持已转后续，可从本条继续报失。</view></view></view></view>
  <view wx:if="{{returnProgress.canReportMissing || returnProgress.followups[0].canRetryMissingLoss}}" class="card">
    <view>归还实物缺失</view>
    <textarea wx:if="{{returnProgress.canReportMissing}}" value="{{reason}}" bindinput="onReason" placeholder="验收说明" disabled="{{busy || retryable}}"/>
    <picker mode="date" value="{{missingDate}}" data-field="missingDate" bindchange="onMissingField" disabled="{{busy || retryable}}"><view>最后见到日期 {{missingDate}}</view></picker>
    <picker mode="time" value="{{missingTime}}" data-field="missingTime" bindchange="onMissingField" disabled="{{busy || retryable}}"><view>最后见到时间 {{missingTime}}</view></picker>
    <input value="{{missingLocation}}" data-field="missingLocation" bindinput="onMissingField" placeholder="最后见到地点" maxlength="500" disabled="{{busy || retryable}}"/>
    <textarea value="{{missingCircumstances}}" data-field="missingCircumstances" bindinput="onMissingField" placeholder="实物查找情况" maxlength="2000" disabled="{{busy || retryable}}"/>
    <button bindtap="onReportMissing" disabled="{{busy || retryable}}">提交关联报失</button>
  </view>
  <button bindtap="onPrevious" disabled="{{busy || retryable || page <= 1}}">上一页</button><view>第 {{page}} 页</view>
  <button bindtap="onNext" disabled="{{busy || retryable || page * 20 >= total}}">下一页</button>
  <navigator url="/pages/mine/index" open-type="redirect">返回我的</navigator>
</view>
