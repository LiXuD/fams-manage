<view class="page">
<view class="card"><view class="title">整机换新与独立入库</view><view>新实物使用独立新卡、新编码和新序列号。旧机维修、借用和待处理责任继续保留。</view><button bindtap="onRefresh" disabled="{{busy || confirmation}}">刷新核对换机资料</button><view role="alert">{{error}}</view><view>{{notice}}</view></view>
<view wx:if="{{retry}}" class="card">结果尚未确认；重试沿用原请求、版本和原件。{{pendingLabel}}<button bindtap="onRetry" disabled="{{busy}}">重试原换机办理</button></view>
<view wx:if="{{confirmation}}" class="card"><view>{{confirmation}}</view><button bindtap="onConfirm" disabled="{{busy}}">确认保存本次换机办理</button><button bindtap="onCancel" disabled="{{busy}}">返回修改换机办理</button></view>
<view wx:for="{{records.items}}" wx:key="id" class="card"><view>旧机实际去向：{{item.originalDisposition}}</view><view wx:if="{{item.inbound}}">新机资产 {{item.replacementAssetId}}；入库单 {{item.inbound.receiptNumber}} · {{item.inbound.status}}。请到PC入库管理独立提交、批准和实际验收入库。</view><view wx:else>新机草稿尚未进入当前身份可办理范围。</view></view>
<view wx:if="{{records.canRecord}}" class="card"><view class="title">厂家整机换新原件</view><button bindtap="onChoose" disabled="{{busy || retry || confirmation || stale}}">选择厂家换机图片或PDF原件</button><view>{{fileName}}</view><button data-action="upload" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">核对追加厂家换机原件</button>
<checkbox-group bindchange="onEvidence"><label wx:for="{{originals}}" wx:key="id"><checkbox value="{{item.id}}" disabled="{{busy || retry || confirmation || stale}}"/>选用厂家换机原件 {{item.name}}</label></checkbox-group>
<view class="title">新机资料及旧机去向</view>
<view>新机资产名称</view><input value="{{name}}" data-field="name" bindinput="onField" maxlength="256" disabled="{{busy || retry || confirmation || stale}}"/>
<view>新机独立序列号</view><input value="{{serial}}" data-field="serial" bindinput="onField" maxlength="128" disabled="{{busy || retry || confirmation || stale}}"/>
<view>新机型号</view><input value="{{model}}" data-field="model" bindinput="onField" maxlength="128" disabled="{{busy || retry || confirmation || stale}}"/>
<view>新机计量单位</view><input value="{{unit}}" data-field="unit" bindinput="onField" maxlength="32" disabled="{{busy || retry || confirmation || stale}}"/>
<view wx:for="{{references}}" wx:for-item="catalog" wx:key="kind"><view>{{catalog.label}} · 第{{catalog.page}}页</view><button wx:for="{{catalog.items}}" wx:key="id" wx:if="{{catalog.kind !== 'location' || item.warehouse.id === references[2].selected}}" data-kind="{{catalog.kind}}" data-id="{{item.id}}" bindtap="onReference" disabled="{{busy || retry || confirmation || stale}}">{{catalog.selected === item.id ? '已选：' : '选择：'}}{{item.code}} · {{item.name}}</button><button wx:if="{{catalog.page > 1}}" data-kind="{{catalog.kind}}" data-delta="-1" bindtap="onReferences" disabled="{{busy || retry || confirmation || stale}}">上一页{{catalog.label}}</button><button wx:if="{{catalog.page * 20 &lt; catalog.total}}" data-kind="{{catalog.kind}}" data-delta="1" bindtap="onReferences" disabled="{{busy || retry || confirmation || stale}}">下一页{{catalog.label}}</button></view>
<view>新机入库业务日期（YYYY-MM-DD）</view><input value="{{businessDate}}" data-field="businessDate" bindinput="onField" disabled="{{busy || retry || confirmation || stale}}"/>
<view>实际换机核实日期（YYYY-MM-DD）</view><input value="{{actualDate}}" data-field="actualDate" bindinput="onField" disabled="{{busy || retry || confirmation || stale}}"/><view>实际换机核实时刻（HH:mm:ss）</view><input value="{{actualTime}}" data-field="actualTime" bindinput="onField" disabled="{{busy || retry || confirmation || stale}}"/><button bindtap="onNow" disabled="{{busy || retry || confirmation || stale}}">填入已现场核实的当前时刻</button>
<view>旧机实际去向</view><button wx:for="{{dispositions}}" wx:key="id" data-id="{{item.id}}" bindtap="onDisposition" disabled="{{busy || retry || confirmation || stale}}">{{disposition === item.id ? '已选：' : '选择：'}}{{item.name}}</button>
<view>厂家换机及旧机去向依据（至少10字）</view><textarea value="{{reason}}" data-field="reason" bindinput="onField" maxlength="1000" disabled="{{busy || retry || confirmation || stale}}"/>
<checkbox-group bindchange="onChecked"><label><checkbox value="checked" checked="{{checked}}" disabled="{{busy || retry || confirmation || stale}}"/>已核实新实物、新序列号及厂家换机凭证，旧机去向依据真实</label></checkbox-group><button data-action="create" bindtap="onPrepare" disabled="{{busy || retry || confirmation || stale}}">核对建立新卡及入库草稿</button></view>
<button bindtap="onBack" disabled="{{busy || retry || confirmation}}">返回返厂轮次</button></view>
